    ["Win.Trojan.Hide-2"]="Obfuscated trojan — likely packed or polymorphic in nature."
    ["Win.Dropper.Remcos"]="Drops the Remcos RAT, enabling remote system control."
    ["Win.Dropper.Formbook"]="Deploys Formbook, a credential and form data stealer."
    ["Win.Dropper.LokiBot"]="Delivers LokiBot, which steals passwords and crypto wallets."
    ["Win.Dropper.NetWire"]="Installs the NetWire RAT for remote system access."
    ["Win.Dropper.Nanocore"]="Used to drop Nanocore RAT for system spying/control."
    ["Win.Dropper.Quasar"]="Drops Quasar RAT, a lightweight remote control tool."
    ["Win.Dropper.DarkComet"]="Installs DarkComet RAT, used for spying and keylogging."
    ["Win.Dropper.XtremeRat"]="Delivers XtremeRAT, enabling full remote control over a system."
    ["Win.Exploit.Kit"]="Exploit kit attempting to compromise vulnerable systems."
    ["Win.Loader.FakeUpdate"]="Fake software updater that installs malware."
    ["Win.Ransom.Stop"]="STOP/DJVU ransomware family, encrypts files and appends random extensions."
    ["Win.Ransom.Locky"]="Old but notable ransomware, spread through malicious email attachments."
    ["Win.Ransom.Phobos"]="Ransomware similar to Dharma, targeting RDP-exposed hosts."
    ["Doc.Downloader.Generic"]="Generic document-based downloader (macros, embedded scripts)."
    ["Doc.Dropper.Emotet"]="Malicious document dropping Emotet malware."
    ["Doc.Dropper.Agent"]="Office document dropping a generic payload (likely malware)."
    ["Txt.Backdoor.Webshell"]="Text-based webshell backdoor for remote server control (often PHP/ASP)."
    ["Php.Malware.Agent"]="Generic PHP malware — often obfuscated shells or injection tools."
    ["Unix.Malware.Ngioweb"]="Proxy bot/backdoor used in advanced botnet infrastructures."
    ["Multios.Coinminer.Miner"]="Cross-platform coinminer — abuses system resources for crypto mining."
    ["Heuristics.Phishing.Email.SpoofedDomain"]="Likely phishing email using a spoofed domain — flagged heuristically."
)

        # CAV file investigation
        echo "CAV file investigation:"
function investigate_cav_files() {
    echo -e "\nSummary:"
    if [ -n "${_cav_identifiers}" ]; then
        echo "${_cav_identifiers}" | sed 's/{CAV}//' | awk -F'-' '{print $1}' | sort | uniq -c | sort -nr | while read -r count signature; do
            description="${cav_descriptions[$signature]}"
            if [[ -n "$description" ]]; then
                printf "• %s: %s file(s) – %s\n" "$signature" "$count" "$description"
            else
                printf "• %s: %s file(s) – [No description available]\n" "$signature" "$count"
            fi
        done
    else
        echo "There are no CAV files"
    fi
    echo -e "\n============================\n"
}
        investigate_cav_files

        # Maldet event log investigation
        function read_files() {
            file_paths=$(echo "$quarantined_files" | grep "$_domain" | awk '{print $4}' 2>/dev/null)
            if [[ -n "$user_files" ]]; then
                file_paths+=$(echo "$quarantined_files" | grep "$user_files" | awk '{print $4}' 2>/dev/null)
            fi
            echo "$file_paths" | while IFS= read -r file_path; do
                sudo cat "${file_path}.info" 2>/dev/null
            done
        }
        echo -e "Maldet event log:\n"
        read_files
    } > ~/merged_mwtool-$(date +%m-%d-%yT%H:%M).txt;
    
    echo "Output redirected to: $output_file" > /dev/tty
}
